{
  "name": "ggm-ops",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "GGM_AUTH",
      "id": "b924e8b5875a418dbd3dbc6b1ff15fe1"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ggm-login",
      "database_id": "a53bc729-c02f-4c2c-a098-07928f7d1b03"
    }
  ]
}
